#include "ns3/core-module.h"
#include "ns3/network-module.h"
#include "ns3/internet-module.h"
#include "ns3/point-to-point-module.h"
#include "ns3/applications-module.h"
#include "ns3/flow-monitor-module.h"

using namespace ns3;

NS_LOG_COMPONENT_DEFINE ("TcpComparisonSimulation");

// Trace sink to record cwnd variations to external file streams
static void
CwndTracer (Ptr<OutputStreamWrapper> stream, uint32_t oldCwnd, uint32_t newCwnd)
{
  *stream->GetStream () << Simulator::Now ().GetSeconds () << "\t" << newCwnd << std::endl;
}

static void
TraceCwnd (std::string nodePath, Ptr<OutputStreamWrapper> stream)
{
  Config::ConnectWithoutContext (nodePath + "/$ns3::TcpL4Protocol/SocketList/0/CongestionWindow", 
                                MakeCallback (&CwndTracer, stream));
}

void RunSimulation(std::string tcpType, std::string filenamePrefix, double errorRate)
{
  // Adjust global socket defaults dynamically based on loop pass configuration parameters
  Config::SetDefault ("ns3::TcpL4Protocol::SocketType", StringValue ("ns3::" + tcpType));

  NodeContainer senders;
  senders.Create (2); // Two competitive sender nodes
  
  Ptr<Node> router = CreateObject<Node> ();
  Ptr<Node> receiver = CreateObject<Node> ();

  // Point to Point Link Setup helpers
  PointToPointHelper accessLinks;
  accessLinks.SetDeviceAttribute ("DataRate", StringValue ("10Mbps"));
  accessLinks.SetChannelAttribute ("Delay", StringValue ("5ms"));

  PointToPointHelper bottleneckLink;
  bottleneckLink.SetDeviceAttribute ("DataRate", StringValue ("2Mbps")); // Shared Bottleneck Link
  bottleneckLink.SetChannelAttribute ("Delay", StringValue ("25ms"));
  bottleneckLink.SetQueue ("ns3::DropTailQueue", "MaxSize", StringValue ("25p")); // Max 25 packets storage capacity

  // Install Hardware interfaces
  NetDeviceContainer dS0_R = accessLinks.Install (senders.Get(0), router);
  NetDeviceContainer dS1_R = accessLinks.Install (senders.Get(1), router);
  NetDeviceContainer dR_Sink = bottleneckLink.Install (router, receiver);

  // Introduce application-level Error Channel Model over bottleneck link paths
  Ptr<RateErrorModel> em = CreateObject<RateErrorModel> ();
  em->SetAttribute ("ErrorRate", DoubleValue (errorRate));
  em->SetAttribute ("ErrorUnit", StringValue ("ERROR_UNIT_PACKET"));
  dR_Sink.Get (1)->SetAttribute ("ReceiveErrorModel", PointerValue (em));

  InternetStackHelper stack;
  stack.InstallAll ();

  // Define IPv4 network boundary addresses
  Ipv4AddressHelper address;
  address.SetBase ("10.1.1.0", "255.255.255.0");
  Ipv4InterfaceContainer iS0_R = address.Assign (dS0_R);

  address.SetBase ("10.1.2.0", "255.255.255.0");
  Ipv4InterfaceContainer iS1_R = address.Assign (dS1_R);

  address.SetBase ("10.1.3.0", "255.255.255.0");
  Ipv4InterfaceContainer iR_Sink = address.Assign (dR_Sink);

  Ipv4GlobalRoutingHelper::PopulateRoutingTables ();

  uint16_t port1 = 8080;
  uint16_t port2 = 9090;

  // Set up Packet Sinks on Receiver Node
  PacketSinkHelper sink1 ("ns3::TcpSocketFactory", InetSocketAddress (Ipv4Address::GetAny (), port1));
  ApplicationContainer sinkApp1 = sink1.Install (receiver);
  sinkApp1.Start (Seconds (0.0));
  sinkApp1.Stop (Seconds (10.0));

  PacketSinkHelper sink2 ("ns3::TcpSocketFactory", InetSocketAddress (Ipv4Address::GetAny (), port2));
  ApplicationContainer sinkApp2 = sink2.Install (receiver);
  sinkApp2.Start (Seconds (0.0));
  sinkApp2.Stop (Seconds (10.0));

  // Configure competitive traffic injection flows from Senders
  BulkSendHelper source1 ("ns3::TcpSocketFactory", InetSocketAddress (iR_Sink.GetAddress (1), port1));
  source1.SetAttribute ("MaxBytes", UintegerValue (0));
  ApplicationContainer sourceApp1 = source1.Install (senders.Get(0));
  sourceApp1.Start (Seconds (1.0));
  sourceApp1.Stop (Seconds (9.0));

  BulkSendHelper source2 ("ns3::TcpSocketFactory", InetSocketAddress (iR_Sink.GetAddress (1), port2));
  source2.SetAttribute ("MaxBytes", UintegerValue (0));
  ApplicationContainer sourceApp2 = source2.Install (senders.Get(1));
  sourceApp2.Start (Seconds (1.5)); // Staggered entry to observe fairness entry loops
  sourceApp2.Stop (Seconds (9.0));

  AsciiTraceHelper asciiTraceHelper;
  Ptr<OutputStreamWrapper> cwndStream = asciiTraceHelper.CreateFileStream (filenamePrefix + "-cwnd.dat");
  Simulator::Schedule (Seconds (1.001), &TraceCwnd, "/NodeList/0", cwndStream);

  FlowMonitorHelper flowmon;
  Ptr<FlowMonitor> monitor = flowmon.InstallAll ();

  Simulator::Stop (Seconds (10.0));
  Simulator::Run ();

  monitor->CheckForLostPackets ();
  Ptr<Ipv4FlowClassifier> classifier = DynamicCast<Ipv4FlowClassifier> (flowmon.GetClassifier ());
  std::map<FlowId, FlowMonitor::FlowStats> stats = monitor->GetFlowStats ();

  double throughput[2] = {0.0, 0.0};
  int idx = 0;
  double totalThroughput = 0;
  double sumOfThroughputs = 0;
  double sumOfSquaresThroughputs = 0;
  double avgDelay = 0;
  uint32_t totalLostPackets = 0;

  for (auto i = stats.begin (); i != stats.end (); ++i)
    {
      Ipv4FlowClassifier::FiveTuple t = classifier->FindFlow (i->first);
      if (t.destinationAddress == "10.1.3.2" && idx < 2)
        {
          double currentThroughput = i->second.rxBytes * 8.0 / (i->second.timeLastRxPacket.GetSeconds() - i->second.timeFirstTxPacket.GetSeconds()) / 1000000;
          throughput[idx] = currentThroughput;
          sumOfThroughputs += currentThroughput;
          sumOfSquaresThroughputs += (currentThroughput * currentThroughput);
          avgDelay += (i->second.delaySum.GetSeconds() / i->second.rxPackets);
          totalLostPackets += i->second.lostPackets;
          idx++;
        }
    }

  // Jain's Fairness Index Calculation Formula = (Σxi)^2 / (n * Σxi^2)
  double fairnessIndex = (sumOfThroughputs * sumOfThroughputs) / (2 * sumOfSquaresThroughputs);
  avgDelay /= 2.0;

  std::cout << "\n---------------- " << tcpType << " (Error Rate: " << errorRate << ") ----------------" << std::endl;
  std::cout << "Flow 1 Throughput      : " << throughput[0] << " Mbps" << std::endl;
  std::cout << "Flow 2 Throughput      : " << throughput[1] << " Mbps" << std::endl;
  std::cout << "Combined Aggregate     : " << sumOfThroughputs << " Mbps" << std::endl;
  std::cout << "Jain's Fairness Index  : " << fairnessIndex << std::endl;
  std::cout << "Average Network Delay  : " << avgDelay << " seconds" << std::endl;
  std::cout << "Aggregated Packet Loss : " << totalLostPackets << " packets" << std::endl;
  std::cout << "---------------------------------------------------------\n" << std::endl;

  Simulator::Destroy ();
}

int main (int argc, char *argv[])
{
  CommandLine cmd (__FILE__);
  cmd.Parse (argc, argv);
  Time::SetResolution (Time::NS);

  // Scenario A: Mild Congestion with Low Packet Loss (0.001)
  std::cout << "========= RUNNING SCENARIO A: MILD CONGESTION ENVIRONMENT =========" << std::endl;
  RunSimulation("TcpNewReno", "newreno-mild", 0.001);
  RunSimulation("TcpCubic", "cubic-mild", 0.001);

  // Scenario B: Extreme Congestion / High Loss Link Environments (0.02)
  std::cout << "\n========= RUNNING SCENARIO B: SEVERE CONGESTION ENVIRONMENT =========" << std::endl;
  RunSimulation("TcpNewReno", "newreno-severe", 0.02);
  RunSimulation("TcpCubic", "cubic-severe", 0.02);

  return 0;
}
