#include <stdio.h>
#include <string.h>
#define MAX_SIZE 64
#define BIT_COUNT 8
void getMessage(char message[], int *length)
{
    FILE *input = fopen("data.txt", "r");

    if (input == NULL)
    {
        printf("Error: Unable to open data.txt\n");
        *length = 0;
        return;
    }

    if (fgets(message, MAX_SIZE, input) == NULL)
    {
        printf("Error: data.txt is empty.\n");
        fclose(input);
        *length = 0;
        return;
    }

    fclose(input);

    *length = strlen(message);

    while (*length > 0 &&
          (message[*length - 1] == '\n' || message[*length - 1] == '\r'))
    {
        message[*length - 1] = '\0';
        (*length)--;
    }

    if (*length == 0)
    {
        printf("Error: Input cannot be empty.\n");
    }
}
void generateParityMatrix(char message[], int length, int parityMatrix[][BIT_COUNT + 1])
{
    int row, column;
    for (row = 0; row < length; row++)
    {
        unsigned char currentChar = (unsigned char)message[row];
        int oneCount = 0;
        for (column = 0; column < BIT_COUNT; column++)
        {
            int bit = (currentChar >> (7 - column)) & 1;
            parityMatrix[row][column] = bit;
            if (bit == 1)
                oneCount++;
        }
        parityMatrix[row][BIT_COUNT] = oneCount % 2;
    }
    for (column = 0; column <= BIT_COUNT; column++)
    {
        int oneCount = 0;
        for (row = 0; row < length; row++)
        {
            if (parityMatrix[row][column] == 1)
                oneCount++;
        }
        parityMatrix[length][column] = oneCount % 2;
    }
}
void displayMatrix(char message[], int length, int parityMatrix[][BIT_COUNT + 1])
{
    int row, column;
    printf("\nGenerated 2D Parity Matrix\n\n");
    printf("Char   | Data Bits (8-bit) | Row Parity\n");
    printf("--------------------------------------\n");
    for (row = 0; row < length; row++)
    {
        printf("  %c    | ", message[row]);
        for (column = 0; column < BIT_COUNT; column++)
        {
            printf("%d ", parityMatrix[row][column]);
        }
        printf("|     %d\n", parityMatrix[row][BIT_COUNT]);
    }
    printf("--------------------------------------\n");
    printf("ColPar | ");
    for (column = 0; column < BIT_COUNT; column++)
    {
        printf("%d ", parityMatrix[length][column]);
    }
    printf("|     %d (Corner Parity)\n",
           parityMatrix[length][BIT_COUNT]);
}
void saveMatrixToFile(int length, int parityMatrix[][BIT_COUNT + 1])
{
    FILE *output = fopen("outmat.txt", "w");
    if (output == NULL)
    {
        printf("File not created\n");
        return;
    }
    fprintf(output, "Rows = %d\n", length);
    fprintf(output, "Cols = %d\n", BIT_COUNT);
    fprintf(output, "Matrix:\n");
    int row,column;
    for (row = 0; row <= length; row++)
    {
        for (column = 0; column <= BIT_COUNT; column++)
        {
            fprintf(output, "%d", parityMatrix[row][column]);
        }
        fprintf(output, "\n");
    }
    fclose(output);
}
int main()
{
    char message[MAX_SIZE];
    int length;
    int parityMatrix[MAX_SIZE + 1][BIT_COUNT + 1];
    printf("2D PARITY SENDER        \n");
    getMessage(message, &length);
    generateParityMatrix(message, length, parityMatrix);
    displayMatrix(message, length, parityMatrix);
    saveMatrixToFile(length, parityMatrix);
    return 0;
}


