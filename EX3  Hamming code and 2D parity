#include <stdio.h>
#include <string.h>
void readFileAndConvertToBinary(char inputBinary[],
                                int message[],
                                int *messageLength)
{
    FILE *fp;
    char text[200];
    int index = 0;
    int i;
    int j;
    int bit;
    unsigned char ch;
    fp = fopen("data.txt", "r");
    if (fp == NULL)
    {
        printf("Unable to open input.txt\n");
        return;
    }
    fgets(text, sizeof(text), fp);
    fclose(fp);
    text[strcspn(text, "\n")] = '\0';
    printf("\nInput String : %s\n", text);
    for (i = 0; text[i] != '\0'; i++)
    {
        printf("%d ", text[i]);
    }
    printf("\n");
    printf("\nBinary Conversion\n");
    for (i = 0; text[i] != '\0'; i++)
    {
        ch = text[i];
        printf("%c -> ", ch);
        for (j = 7; j >= 0; j--)
        {
            bit = (ch >> j) & 1;
            inputBinary[index] = bit + '0';
            message[index] = bit;
            printf("%d", bit);
            index++;
        }
        printf("\n");
    }
    inputBinary[index] = '\0';
    *messageLength = index;
    printf("\nComplete Binary Data : %s\n", inputBinary);
    printf("Total Data Bits : %d\n", *messageLength);
}
int calculateParityBits(int messageLength)
{
    int parityCount = 0;
    while ((1 << parityCount) < (messageLength + parityCount + 1))
    {
        parityCount++;
    }
    return parityCount;
}
void generateHammingCode(int message[],
                         int messageLength,
                         int parityCount,
                         int hamming[])
{
    int totalLength;
    int pointer;
    int position;
    int bit;
    int parityPosition;
    int ones;
    totalLength = messageLength + parityCount;
    pointer = messageLength - 1;
    printf("       HAMMING CODE GENERATION\n");
    printf("\nStep 1 : Place Data Bits\n");
    for (position = 1; position <= totalLength; position++)
    {
        if ((position & (position - 1)) == 0)
        {
            hamming[position] = 0;
        }
        else
        {
            hamming[position] = message[pointer];
            pointer--;
        }
    }
    printf("\nPosition : ");
    for (position = totalLength; position >= 1; position--)
    {
        printf("%2d ", position);
    }
    printf("\nBits     : ");
    for (position = totalLength; position >= 1; position--)
    {
        if ((position & (position - 1)) == 0)
        {
            printf(" P ");
        }
        else
        {
            printf(" %d ", hamming[position]);
        }
    }
    printf("\n");
    printf("\nStep 2 : Calculate Parity Bits (Even Parity)\n");
    for (bit = 0; bit < parityCount; bit++)
    {
        parityPosition = 1 << bit;
        ones = 0;
        printf("Calculating P%d\n", parityPosition);
        printf("Positions Checked : ");
        for (position = 1; position <= totalLength; position++)
        {
            if ((position & parityPosition) && position != parityPosition)
            {
                printf("%d ", position);
                ones += hamming[position];
            }
        }
        hamming[parityPosition] = ones % 2;
        printf("\nNumber of 1's : %d", ones);
        printf("\nP%d = %d\n", parityPosition, hamming[parityPosition]);
    }
    printf("\n---------------------------------\n");
    printf("\nStep 3 : Final Hamming Code\n");
    printf("Position : ");
    for (position = totalLength; position >= 1; position--)
    {
        printf("%2d ", position);
    }
    printf("\nCode     : ");
    for (position = totalLength; position >= 1; position--)
    {
        printf(" %d ", hamming[position]);
    }
    printf("\n");
}
/* Display Final Result */
void displayResult(int messageLength,
                   int parityCount,
                   int hamming[])
{
    int totalLength;
    int position;

    totalLength = messageLength + parityCount;

    printf("\n=========================================\n");
    printf("              RESULT\n");
    printf("=========================================\n");

    printf("Data Bits        : %d\n", messageLength);
    printf("Parity Bits      : %d\n", parityCount);
    printf("Total Code Bits  : %d\n", totalLength);

    printf("\nGenerated Hamming Code : ");

    for (position = totalLength; position >= 1; position--)
    {
        printf("%d", hamming[position]);
    }

    printf("\n");
}

/* Save Hamming Code into File */
void saveToFile(int messageLength,
                int parityCount,
                int hamming[])
{
    FILE *channel;

    int totalLength;
    int position;

    totalLength = messageLength + parityCount;

    channel = fopen("channel.txt", "w");

    if (channel == NULL)
    {
        printf("Unable to create channel.txt\n");
        return;
    }

    fprintf(channel, "%d\n", messageLength);
    fprintf(channel, "%d\n", parityCount);

    for (position = totalLength; position >= 1; position--)
    {
        fprintf(channel, "%d", hamming[position]);
    }

    fprintf(channel, "\n");

    fclose(channel);
}
int main()
{
    char inputBinary[50];
    int message[50];
    int hamming[50+ 1] = {0};
    int messageLength;
    int parityCount;
    printf("         HAMMING CODE SENDER\n");
    readFileAndConvertToBinary(inputBinary, message, &messageLength);
    parityCount = calculateParityBits(messageLength);
    generateHammingCode(message, messageLength, parityCount, hamming);
    displayResult(messageLength, parityCount, hamming);
    saveToFile(messageLength, parityCount, hamming);
    return 0;
}


