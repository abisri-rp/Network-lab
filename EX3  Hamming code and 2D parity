/* Convert received string into integer array */
void convertToArray(char receivedCode[],
                    int hamming[],
                    int totalBits)
{
    int length;
    int i;

    length = strlen(receivedCode);

    for (i = 0; i < length; i++)
    {
        hamming[length - i] = receivedCode[i] - '0';
    }
}

/* Simulate transmission error */
void simulateError(int hamming[],
                   int totalBits)
{
    char option;
    int flipPosition;
    int i;

    printf("\nSimulate transmission error? (Y/N): ");

    scanf(" %c", &option);

    if (option == 'Y' || option == 'y')
    {
        printf("No of bits to flip : ");

        scanf("%d", &flippedBits);

        for (i = 0; i <flippedBits; i++)
        {
            while (1)
            {
                printf("Enter bit position to flip (1-%d): ",
                       totalBits);

                scanf("%d", &flipPosition);

                if (flipPosition >= 1 &&
                    flipPosition <= totalBits)
                {
                    break;
                }

                printf("Invalid Position!\n");
            }

            hamming[flipPosition] ^= 1;

            printf("Bit %d has been flipped.\n",
                   flipPosition);
        }
    }
}
