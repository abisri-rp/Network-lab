/* Detect Error */
int detectError(int hamming[],
                int totalBits,
                int parityBits)
{
    int errorPosition;
    int i;
    int j;
    int parityPosition;
    int ones;

    errorPosition = 0;

    printf("\n=========================================\n");
    printf("         ERROR DETECTION\n");
    printf("=========================================\n");

    for (i = 0; i < parityBits; i++)
    {
        parityPosition = 1 << i;

        ones = 0;

        printf("\nChecking P%d\n", parityPosition);

        printf("Positions : ");

        for (j = 1; j <= totalBits; j++)
        {
            if (j & parityPosition)
            {
                printf("%d ", j);
            }
        }

        printf("\nBits      : ");

        for (j = 1; j <= totalBits; j++)
        {
            if (j & parityPosition)
            {
                printf("%d ", hamming[j]);

                ones += hamming[j];
            }
        }

        if (ones % 2 == 0)
        {
            printf("\nP%d = 0 (PASS)\n",
                   parityPosition);
        }
        else
        {
            printf("\nP%d = 1 (FAIL)\n",
                   parityPosition);

            errorPosition += parityPosition;
        }
    }

    printf("\n-----------------------------------------\n");

    printf("Syndrome (Binary) : ");

    for (i = parityBits - 1; i >= 0; i--)
    {
        printf("%d",
               (errorPosition >> i) & 1);
    }

    printf("\n");

    printf("Syndrome (Decimal): %d\n",
           errorPosition);

    printf("-----------------------------------------\n");

    return errorPosition;
}

/* Correct Error */
void correctError(int hamming[],
                  int totalBits,
                  int errorPosition)
{
    hamming[errorPosition] ^= 1;

    printf("\nError Corrected Successfully.\n");
}
