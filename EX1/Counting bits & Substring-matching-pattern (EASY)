1. Counting bits

#include <stdlib.h>
int* countBits(int n, int* returnSize) {
    *returnSize = n + 1;
    int* ans = (int*)malloc((*returnSize) * sizeof(int)); 
    ans[0] = 0;
    for (int i = 1; i <= n; ++i) {
        ans[i] = ans[i >> 1] + (i & 1);
    }
    return ans;
}

2. Substring-matching-pattern

#include <stdbool.h>
#include <string.h>

bool hasMatch(char* s, char* p) {
    char *star = strchr(p, '*');
    int prefixLen = star - p;
    int suffixLen = strlen(star + 1);
    int sLen = strlen(s);
    for (int i = 0; i <= sLen - prefixLen; i++) {
        if (strncmp(s + i, p, prefixLen) == 0) {
            if (suffixLen == 0)
                return true;
            for (int j = i + prefixLen; j <= sLen - suffixLen; j++) {
                if (strncmp(s + j, star + 1, suffixLen) == 0)
                    return true;
            }
        }
    }
    return false;
}
