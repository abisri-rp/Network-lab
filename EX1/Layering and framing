int printTransmission(int sIdx, int dIdx, const char *buffer, int totalFrames, int srcPort) {
    printf("\n--------------------------\n");
    printf(" TRANSMISSION \n");
    printf("----------------------------\n");
    printf("  Total Frames Sent  : %d\n", totalFrames);
    printf("  Complete Message   : %s\n", buffer);
    printf("  Source Port        : %-14d | Destination Port    : 50054\n", srcPort);
    printf("  Source IP          : %d.%d.%d.%d  | Destination IP      : %d.%d.%d.%d\n",
           table[sIdx].ip[0], table[sIdx].ip[1], table[sIdx].ip[2], table[sIdx].ip[3],
           table[dIdx].ip[0], table[dIdx].ip[1], table[dIdx].ip[2], table[dIdx].ip[3]);
    printf("  Source MAC         : %s  | Destination MAC     : %s\n", table[sIdx].mac, table[dIdx].mac);
    return 1;
}
void executeNetwork(int sIdx, int dIdx, const char *buffer, int totalLen, int srcPort, int packetBitSize, int frameBitSize) {
    int totalFrames;
    printApplicationLayer(buffer, totalLen);
    printTransportLayer(srcPort, buffer, totalLen);
    printNetworkLayer(sIdx, dIdx, buffer, totalLen, packetBitSize, srcPort);
    totalFrames = printDataLinkLabel(sIdx, dIdx, buffer, totalLen, srcPort, packetBitSize, frameBitSize);
    printPhysicalLayer(sIdx, dIdx, buffer, totalLen, srcPort, packetBitSize, frameBitSize);
    printTransmission(sIdx, dIdx, buffer, totalFrames, srcPort);
}
int main()
{
    int choice, i, j;
    int sIdx, dIdx;
    int len;
    int packetBitSize, frameBitSize;
    int randomSrcPort;
    char src[30];
    char dest[30];
    char fileName[30];
    char buffer[100];
    char delUrl[30];
    FILE *fp;
    srand((unsigned int)time(NULL));
    strcpy(table[0].url, "client.lan");
    table[0].ip[0]=192;
    table[0].ip[1]=168;
    table[0].ip[2]=1;
    table[0].ip[3]=10;
    strcpy(table[0].mac,"AA:BB:CC:DD:EE:FF");
    strcpy(table[1].url,"google.com");
    table[1].ip[0]=142;
    table[1].ip[1]=250;
    table[1].ip[2]=190;
    table[1].ip[3]=46;
    strcpy(table[1].mac,"11:22:33:44:55:66");
    entryCount = 2;
    while(1)
    {
        printf("\nMENU\n");
        printf("1. Add Network Node\n");
        printf("2. Delete Network Node\n");
        printf("3. Generate & Stream Frame\n");
        printf("4. View Network Table\n");
        printf("5. Exit Program\n");
        printf("Enter your choice : ");
        scanf("%d",&choice);
        switch(choice)
        {
        case 1:
            if(entryCount>=20)
            {
                printf("\nNetwork Table Full.\n");
                break;
            }
            printf("\nEnter Domain URL : ");
            scanf("%s",table[entryCount].url);
            printf("Enter IP Address (xxx.xxx.xxx.xxx): ");
            scanf("%d.%d.%d.%d",&table[entryCount].ip[0],&table[entryCount].ip[1],&table[entryCount].ip[2],&table[entryCount].ip[3]);
            printf("Enter MAC Address (XX:XX:XX:XX:XX:XX): ");
            scanf("%s",table[entryCount].mac);
            entryCount++;
            printf("\nNode Added Successfully.\n");
            break;
        case 2:
            printf("\nEnter URL to Delete : ");
            scanf("%s",delUrl);
            sIdx=-1;
            for(i=0;i<entryCount;i++)
            {
                if(strcmp(table[i].url,delUrl)==0)
                {
                    sIdx=i;
                    break;
                }
            }
            if(sIdx==-1)
            {
                printf("\nURL Not Found.\n");
            }
            else
            {
                for(j=sIdx;j<entryCount-1;j++)
                {
                    table[j]=table[j+1];
                }
                entryCount--;
                printf("\nNode Deleted Successfully.\n");
            }
            break;
        case 3:
            printf("\nSource URL : ");
            scanf("%s",src);
            printf("Destination URL : ");
            scanf("%s",dest);
            printf("Packet Size (Bits) : ");
            scanf("%d",&packetBitSize);
            printf("Frame Size (Bits) : ");
            scanf("%d",&frameBitSize);
            printf("Enter File Name : ");
            scanf("%s",fileName);
            fp=fopen(fileName,"r");
            if(fp==NULL)
            {
                printf("\nFile Not Found.\n");
                break;
            }
            fgets(buffer,sizeof(buffer),fp);
            fclose(fp);
            len=strlen(buffer);
            if(len>0 && buffer[len-1]=='\n')
            {
                buffer[len-1]='\0';
                len--;
            }
            sIdx=-1;
            dIdx=-1;
            for(i=0;i<entryCount;i++)
            {
                if(strcmp(src,table[i].url)==0)
                    sIdx=i;
                if(strcmp(dest,table[i].url)==0)
                    dIdx=i;
            }
            if(sIdx==-1 || dIdx==-1)
            {
                printf("\nInvalid Source/Destination URL.\n");
                break;
            }
            randomSrcPort=(rand()%49152)+1024;
            executeNetwork(sIdx,dIdx,buffer,len,randomSrcPort,packetBitSize,frameBitSize);
            break;
        case 4:
            displayTable();
            break;
        case 5:
            printf("\nExit\n");
            return 0;
        default:
            printf("\nInvalid Choice.\n");
        }
    }
    return 0;
}


