    printf("\n");
    printf("COUNT      : ");
    print_as_binary(count_val, 14);
    printf("\n");
    printf("Header\n");
    print_as_binary(header_bits_len / 8, 8);
    printf("\n");
    if (header_bits_len >= 192) {
        printf("Source MAC        : ");
        print_bit_block(binary_str, header_start_bit + src_mac_offset, 48);
        printf("\n");
        printf("Destination MAC   : ");
        print_bit_block(binary_str, header_start_bit + dest_mac_offset, 48);
        printf("\n");
        printf("Source IP         : ");
        print_bit_block(binary_str, header_start_bit + src_ip_offset, 32);
        printf("\n");
        printf("Destination IP    : ");
        print_bit_block(binary_str, header_start_bit + dest_ip_offset, 32);
        printf("\n");
        printf("Source Port       : ");
