#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_BITS 2048
unsigned int binary(const char *binary_str, int start, int length) {
    unsigned int val = 0;
    int i;
    for (i = 0; i < length; i++) {
        val <<= 1;
        if (binary_str[start + i] == '1') {
            val |= 1;
        }
    }
    return val;
}
void print_as_binary(unsigned int value, int bit_width) {
    int i;
    for (i = bit_width - 1; i >= 0; i--) {
        printf("%d", (value >> i) & 1);
    }
}
void print_bit_block(const char *binary_str, int start_bit, int bit_length) {
    int i;
    for (i = 0; i < bit_length; i++) {
        printf("%c", binary_str[start_bit + i]);
    }
}
int main() {
    char file_name[256];
    char raw_buffer[MAX_BITS];
    char binary_str[MAX_BITS];
    char decoded_message[256];
    FILE *file;
    int bit_count = 0;
    int i = 0;
    int msg_index = 0;
    unsigned int syn1;
    unsigned int syn2;
    unsigned int class_val;
    unsigned int count_val;
    unsigned int crc;
    int header_start_bit = 38;
    int total_payload_bits;
    int message_bits_len;
    int header_bits_len;
    int message_start_bit;
    int actual_msg_length;
    unsigned int char_code;
    int src_mac_offset   = 0;
    int dest_mac_offset  = 48;
    int src_ip_offset    = 96;
    int dest_ip_offset   = 128;
    int src_port_offset  = 160;
    int dest_port_offset = 176;
    printf("Enter the binary data file name: ");
    if (scanf("%255s", file_name) != 1) {
        printf("Error reading file name input.\n");
        return 1;
    }
    file = fopen(file_name, "r");
    if (file == NULL) {
        printf("Can't open file");
        return 1;
    }
    while (fgets(raw_buffer, sizeof(raw_buffer), file) != NULL) {
        for (i = 0; raw_buffer[i] != '\0'; i++) {
            if (raw_buffer[i] == '0' || raw_buffer[i] == '1') {
                if (bit_count < MAX_BITS - 1) {
                    binary_str[bit_count] = raw_buffer[i];
                    bit_count++;
                }
            }
        }
    }
    binary_str[bit_count] = '\0';
    fclose(file);
    if (bit_count < 46) {
        printf("Error: File data does not contain enough bits for a frame prefix.\n");
        return 1;
    }
    syn1       = binary(binary_str, 0, 8);
    syn2       = binary(binary_str, 8, 8);
    class_val  = binary(binary_str, 16, 8);
    count_val  = binary(binary_str, 24, 14);
    crc        = binary(binary_str, bit_count - 8, 8);
    total_payload_bits = (bit_count - 8) - header_start_bit;
    message_bits_len = count_val * 8;
    header_bits_len = total_payload_bits - message_bits_len;
    message_start_bit = header_start_bit + header_bits_len;
    actual_msg_length = message_bits_len / 8;
    for (i = 0; i < actual_msg_length && msg_index < 255; i++) {
        char_code = binary(binary_str, message_start_bit + (i * 8), 8);
        decoded_message[msg_index] = (char)char_code;
        msg_index++;
    }
    decoded_message[msg_index] = '\0';
    printf("SYN             : ");
