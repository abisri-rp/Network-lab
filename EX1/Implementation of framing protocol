int Binary(int num, char *str)
{
    int i;
    for(i=0;i<8;i++)
        str[i]='0';
    str[8]='\0';
    for(i=7;i>=0;i--)
    {
        if(num%2)
            str[i]='1';
        num/=2;
    }
    return 1;
}
int portToBinary(int port,char *str)
{
    char high[9],low[9];
    int index=0,i;
    Binary(port/256,high);
    Binary(port%256,low);
    for(i=0;i<8;i++)
        str[index++]=high[i];
    str[index++]=' ';
    for(i=0;i<8;i++)
        str[index++]=low[i];
    str[index]='\0';
    return 1;
}
int macToBinary(const char *mac,char *str)
{
    int len=strlen(mac);
    int index=0,count=0;
    int i,j;
    for(i=0;i<len;i++)
    {
        int value,temp;
        if(mac[i]==':')
            continue;
        if(mac[i]>='0' && mac[i]<='9')
            value=mac[i]-'0';
        else if(mac[i]>='A' && mac[i]<='F')
            value=mac[i]-'A'+10;
        else
            value=mac[i]-'a'+10;
        temp=value;
        for(j=3;j>=0;j--)
        {
            if(temp%2)
                str[index+j]='1';
            else
                str[index+j]='0';
            temp/=2;
        }
        index+=4;
        count++;
        if(count%2==0 && i<len-1)
            str[index++]=' ';
    }
    str[index]='\0';
    return 1;
}
void performCharacterStuffing(const char *message)
{
    int i=0,j=0;
    while(message[i]!='\0')
    {
        if(strncmp(&message[i],"DLE",3)==0)
        {
            strcpy(&stuffedMessage[j],"DLE DLE");
            j+=7;
            i+=3;
        }
        else if(strncmp(&message[i],"ETX",3)==0)
        {
            strcpy(&stuffedMessage[j],"DLE ETX");
            j+=7;
            i+=3;
        }
        else if(strncmp(&message[i],"STX",3)==0)
        {
            strcpy(&stuffedMessage[j],"DLE STX");
            j+=7;
            i+=3;
        }
        else
        {
            stuffedMessage[j++]=message[i++];
        }
    }
    stuffedMessage[j]='\0';
}
void BISYNCProtocol(int sIdx, int dIdx, int srcPort)
{
    FILE *fp;
    int i;
    char srcMacBin[100], destMacBin[100];
    char srcPortBin[30], destPortBin[30];
    char srcIP[50] = "", destIP[50] = "", temp[9];
    char binary[9];
    fp = fopen("output.txt", "w");
    if(fp == NULL)
    {
        printf("\nUnable to create file.\n");
        return;
    }
    macToBinary(table[sIdx].mac, srcMacBin);
    macToBinary(table[dIdx].mac, destMacBin);
    portToBinary(srcPort, srcPortBin);
    portToBinary(50054, destPortBin);
    for(i=0;i<4;i++)
    {
        Binary(table[sIdx].ip[i], temp);
        strcat(srcIP, temp);
        if(i<3)
            strcat(srcIP, " ");
    }
    for(i=0;i<4;i++)
    {
        Binary(table[dIdx].ip[i], temp);
        strcat(destIP, temp);
        if(i<3)
            strcat(destIP, " ");
    }
    fprintf(fp,"00010110");
    fprintf(fp,"00010110");
    fprintf(fp,"00000001");
    fprintf(fp,"%s",srcMacBin);
    fprintf(fp,"%s",destMacBin);
    fprintf(fp,"%s",srcIP);
    fprintf(fp,"%s",destIP);
    fprintf(fp,"%s", srcPortBin);
    fprintf(fp,"%s", destPortBin);
    fprintf(fp,"00000010");
    for(i=0; stuffedMessage[i]!='\0'; i++)
    {
        Binary((unsigned char)stuffedMessage[i], binary);
        fprintf(fp,"%s ", binary);
    }
    fprintf(fp,"00000011");
    fprintf(fp,"00000000");
    fclose(fp);
}
