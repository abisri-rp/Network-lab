#include <stdio.h>
#include <stdlib.h>
#include <string.h>
char receivedPayload[1000];
char destuffedMessage[1000];
unsigned char binaryToByte(const char *binStr)
{
    unsigned char val = 0;
    int i;
    for(i = 0; i < 8; i++)
    {
        val <<= 1;
        if(binStr[i] == '1')
            val |= 1;
    }
    return val;
}
void performCharacterDestuffing(const char *stuffedStr)
{
    int i = 0, j = 0;
    int len = strlen(stuffedStr);
    while(i < len)
    {
        if(strncmp(&stuffedStr[i], "DLE DLE", 7) == 0)
        {
            strcpy(&destuffedMessage[j], "DLE");
            j += 3;
            i += 7;
        }
        else if(strncmp(&stuffedStr[i], "DLE ETX", 7) == 0)
        {
            strcpy(&destuffedMessage[j], "ETX");
            j += 3;
            i += 7;
        }
        else if(strncmp(&stuffedStr[i],"DLE STX",7)==0)
        {
           strcpy(&destuffedMessage[j], "STX");
           j += 3;
           i += 7;
        }
        else
        {
            destuffedMessage[j++] = stuffedStr[i++];
        }
    }
    destuffedMessage[j] = '\0';
}
