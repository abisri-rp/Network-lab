#include <stdbool.h>
#include <string.h>

bool hasMatch(char* s, char* p) {
    char *star = strchr(p, '*');
    int prefixLen = star - p;
    int suffixLen = strlen(star + 1);
    int sLen = strlen(s);
    for (int i = 0; i <= sLen - prefixLen; i++) {
        if (strncmp(s + i, p, prefixLen) == 0) {
            if (suffixLen == 0)
                return true;
            for (int j = i + prefixLen; j <= sLen - suffixLen; j++) {
                if (strncmp(s + j, star + 1, suffixLen) == 0)
                    return true;
            }
        }
    }
    return false;
}
