1.Minimum Bit Flips to Convert Number

#include <stdio.h>
int minBitFlips(int start, int goal) 
{
    int xor_result = start ^ goal;
    int count = 0;
    while (xor_result > 0)
    {
        xor_result = xor_result & (xor_result - 1);
        count++;
    }
    return count;
}


2.Hamming Distance

int hammingDistance(int x, int y) 
{
    int xor_result = x ^ y;
    int distance = 0;
    while (xor_result > 0) {
        xor_result = xor_result & (xor_result - 1);
        distance++;
    }   
    return distance;
}
