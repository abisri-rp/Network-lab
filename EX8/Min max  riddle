#include <bits/stdc++.h>
using namespace std;

vector<long> riddle(vector<long> arr) {
    int n = arr.size();
    vector<int> left(n, -1);
    vector<int> right(n, n);
    stack<int> s;

    // Left boundaries
    for (int i = 0; i < n; i++) {
        while (!s.empty() && arr[s.top()] >= arr[i]) {
            s.pop();
        }
        if (!s.empty()) {
            left[i] = s.top();
        }
        s.push(i);
    }

    while (!s.empty()) s.pop();

    // Right boundaries
    for (int i = n - 1; i >= 0; i--) {
        while (!s.empty() && arr[s.top()] >= arr[i]) {
            s.pop();
        }
        if (!s.empty()) {
            right[i] = s.top();
        }
        s.push(i);
    }

    // Map window lengths to maximum values
    vector<long> ans(n + 1, 0);
    for (int i = 0; i < n; i++) {
        int len = right[i] - left[i] - 1;
        ans[len] = max(ans[len], arr[i]);
    }

    // Pass values backwards to cover smaller ranges
    for (int i = n - 1; i >= 1; i--) {
        ans[i] = max(ans[i], ans[i + 1]);
    }

    vector<long> res(ans.begin() + 1, ans.end());
    return res;
}
