#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>

#define PORT 8093
#define SIZE 1024

struct rpc_request
{
    int a;
    int b;
};

struct rpc_response
{
    int result;
};

int main()
{
    int sockfd;
    struct sockaddr_in server, client;
    socklen_t len;
    struct rpc_request req;
    struct rpc_response res;
    pid_t pid;

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr *)&server,
             sizeof(server)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }

    printf("UDP Concurrent RPC Server started...\n");
    printf("Waiting for client requests...\n");

    while (1)
    {
        len = sizeof(client);

        recvfrom(sockfd, &req, sizeof(req), 0,
                 (struct sockaddr *)&client, &len);

        printf("\nRPC Request received\n");
        printf("Numbers: %d and %d\n", req.a, req.b);

        pid = fork();

        if (pid < 0)
        {
            perror("Fork failed");
        }
        else if (pid == 0)
        {
            printf("Child process %d handling RPC\n", getpid());

            /* Remote procedure execution */
            res.result = req.a + req.b;

            sendto(sockfd, &res, sizeof(res), 0,
                   (struct sockaddr *)&client, len);

            printf("RPC Result sent: %d\n", res.result);

            close(sockfd);
            exit(0);
        }
    }

    close(sockfd);

    return 0;
}
