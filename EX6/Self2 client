#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <unistd.h>
#include <arpa/inet.h>
#include "hospital_protocol.h"

void display_schedules(const HospitalResponse* res) {
    printf("\n=================== DOCTOR AVAILABILITY SCHEDULES ===================\n");
    for (int i = 0; i < res->count; i++) {
        printf("Doctor ID      : %d\n", res->doctors[i].doctor_id);
        printf("Name           : %s\n", res->doctors[i].name);
        printf("Specialization : %s\n", res->doctors[i].specialization);
        printf("Timings        : %s\n", res->doctors[i].timings);
        printf("Slot Statuses  : ");
        for (int j = 0; j < MAX_SLOTS; j++) {
            printf("[Slot %d: %s] ", j + 1, res->doctors[i].slot_booked[j] ? "BOOKED" : "AVAILABLE");
        }
        printf("\n--------------------------------------------------------------------\n");
    }
}

int main() {
    int sock = 0;
    struct sockaddr_in serv_addr;
    HospitalRequest req;
    HospitalResponse res;
    int patient_id = 0;
    char patient_name[MAX_STR] = "";
    bool registered = false;

    if ((sock = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
        printf("\n Socket system instantiation failed \n");
        return -1;
    }

    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(SERVER_PORT);

    if (inet_pton(AF_INET, SERVER_IP, &serv_addr.sin_addr) <= 0) {
        printf("\n Invalid target execution address standard \n");
        return -1;
    }

    if (connect(sock, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        printf("\n Server connection failed. System might be busy serving another client. \n");
        return -1;
    }

    printf("[CLIENT] Network sync established with Hospital Server.\n");

    // Enforce patient initialization configuration profiles first
    printf("Enter your numeric Patient Registration ID to start: ");
    scanf("%d", &patient_id);
    printf("Enter Patient Full Name: ");
    scanf(" %[^\n]s", patient_name);

    // Auto-register immediately upon launching initialization structures
    memset(&req, 0, sizeof(HospitalRequest));
    req.cmd = CMD_REGISTER;
    req.patient_id = patient_id;
    strcpy(req.patient_name, patient_name);
    send(sock, &req, sizeof(HospitalRequest), 0);
    recv(sock, &res, sizeof(HospitalResponse), 0);
    printf(">> SERVERSIDE RESPONSE: %s\n", res.message);

    int choice;
    while (1) {
        printf("\n=== Hospital Appointment System Operations Menu ===\n");
        printf("1. Search Doctor Schedules & Available Slots\n");
        printf("2. Book a Consultation Appointment\n");
        printf("3. Cancel a Booked Appointment Slot\n");
        printf("4. View Active Patient Account History\n");
        printf("5. Disconnect Session and Exit\n");
        printf("Select command option: ");
        if (scanf("%d", &choice) != 1) break;

        memset(&req, 0, sizeof(HospitalRequest));
        req.patient_id = patient_id;
        strcpy(req.patient_name, patient_name);

        if (choice == 5) {
            req.cmd = CMD_EXIT;
            send(sock, &req, sizeof(HospitalRequest), 0);
            break;
        }

        switch (choice) {
            case 1:
                req.cmd = CMD_SEARCH_AVAILABILITY;
                break;
            case 2:
                req.cmd = CMD_BOOK_APPOINTMENT;
                printf("Enter Target Doctor ID (e.g., 101, 102): ");
                scanf("%d", &req.target_doctor_id);
                printf("Enter Target Slot Number Option (1 to %d): ", MAX_SLOTS);
                scanf("%d", &req.target_slot);
                break;
            case 3:
                req.cmd = CMD_CANCEL_APPOINTMENT;
                printf("Enter target Doctor ID relative to booking: ");
                scanf("%d", &req.target_doctor_id);
                printf("Enter slot index relative to booking (1-%d): ", MAX_SLOTS);
                scanf("%d", &req.target_slot);
                break;
            case 4:
                req.cmd = CMD_VIEW_HISTORY;
                break;
            default:
                printf("Invalid configuration parameters selected.\n");
                continue;
        }

        // Transmit struct package over network wire boundary lines cleanly
        send(sock, &req, sizeof(HospitalRequest), 0);
        
        // Receive transactional outcomes safely
        memset(&res, 0, sizeof(HospitalResponse));
        int total_received = 0;
        int target_size = sizeof(HospitalResponse);
        char* ptr = (char*)&res;
        
        while (total_received < target_size) {
            int read_bytes = recv(sock, ptr + total_received, target_size - total_received, 0);
            if (read_bytes <= 0) {
                printf("Connection stream disrupted by remote subsystem host processing nodes.\n");
                close(sock);
                return -1;
            }
            total_received += read_bytes;
        }

        if (res.success) {
            printf("\n>> TRANSACTION SUCCESS RESULT: %s\n", res.message);
            if (req.cmd == CMD_SEARCH_AVAILABILITY) {
                display_schedules(&res);
            }
        } else {
            printf("\n>> SERVER ERROR FAULT: %s\n", res.message);
        }
    }

    close(sock);
    printf("[CLIENT] Disconnect completed successfully.\n");
    return 0;
}
