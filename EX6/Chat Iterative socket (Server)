#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SIZE 1024

int main(int argc, char *argv[])
{
    int serverSocket, clientSocket;
    int port;
    struct sockaddr_in serverAddr, clientAddr;
    socklen_t addrSize;
    char buffer[SIZE];
    int opt = 1;

    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[1]);

    serverSocket = socket(AF_INET, SOCK_STREAM, 0);
    if (serverSocket < 0)
    {
        perror("Socket creation failed");
        return 1;
    }
    if (setsockopt(serverSocket, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) < 0)
    {
        perror("setsockopt SO_REUSEADDR failed");
        close(serverSocket);
        return 1;
    }

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_addr.s_addr = INADDR_ANY;
    serverAddr.sin_port = htons(port);

    if (bind(serverSocket, (struct sockaddr *)&serverAddr, sizeof(serverAddr)) < 0)
    {
        perror("Bind failed");
        close(serverSocket);
        return 1;
    }

    if (listen(serverSocket, 5) < 0)
    {
        perror("Listen failed");
        close(serverSocket);
        return 1;
    }

    printf("Server started on port %d\n", port);

    // Flag to determine if the entire server process should terminate
    int keepRunningServer = 1;

    while (keepRunningServer)
    {
        printf("Waiting for client...\n");
        addrSize = sizeof(clientAddr);

        clientSocket = accept(serverSocket, (struct sockaddr *)&clientAddr, &addrSize);
        if (clientSocket < 0)
        {
            perror("Accept failed");
            continue;
        }

        // Display connected client details
        char clientIP[INET_ADDRSTRLEN];
        inet_ntop(AF_INET, &clientAddr.sin_addr, clientIP, INET_ADDRSTRLEN);
        printf("\nClient connected from %s:%d\n", clientIP, ntohs(clientAddr.sin_port));

        while (1)
        {
            memset(buffer, 0, SIZE);
            int bytes = recv(clientSocket, buffer, SIZE - 1, 0);

            if (bytes <= 0)
            {
                if (bytes == 0)
                    printf("Client disconnected gracefully.\n");
                else
                    perror("Receive failed");
                break;
            }

            buffer[bytes] = '\0';
            printf("Client: %s\n", buffer);

            if (strcmp(buffer, "exit") == 0)
                break;

            // Send to client loop
            while (1) {
                printf("Server: ");
                if (fgets(buffer, SIZE, stdin) == NULL) {
                    buffer[0] = '\0';
                }

                buffer[strcspn(buffer, "\n")] = '\0';

                // Prevent deadlocking the client with empty payloads
                if (strlen(buffer) > 0) {
                    break;
                }
            }

            if (send(clientSocket, buffer, strlen(buffer), 0) < 0) {
                perror("Send failed");
                break;
            }

                if (strcmp(buffer, "exit") == 0) {
                keepRunningServer = 0;
                break;
            }
        }

        close(clientSocket);
        printf("Client socket closed.\n\n");
    }

    close(serverSocket);
    printf("Server shut down successfully.\n");
    return 0;
}
