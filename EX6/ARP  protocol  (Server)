#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define SIZE 1024
#define MAX_ENTRIES 20

struct ARPEntry
{
    char ip[20];
    char mac[20];
};

struct ARPEntry arpTable[MAX_ENTRIES] =
{
    {"192.168.1.1", "AA:BB:CC:DD:EE:01"},
    {"192.168.1.2", "AA:BB:CC:DD:EE:02"},
    {"192.168.1.3", "AA:BB:CC:DD:EE:03"}
};

int entryCount = 3;

int main(int argc, char *argv[])
{
    int serverSocket;
    int clientSocket;
    int port;

    struct sockaddr_in serverAddr;
    struct sockaddr_in clientAddr;

    socklen_t addrSize;

    char ip[SIZE];
    char mac[SIZE];
    char response[SIZE];

    int i;
    int found;

    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[1]);

    /* Create socket */
    serverSocket = socket(AF_INET, SOCK_STREAM, 0);

    if (serverSocket < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    /* Server address */
    serverAddr.sin_family = AF_INET;
    serverAddr.sin_addr.s_addr = INADDR_ANY;
    serverAddr.sin_port = htons(port);

    /* Bind */
    if (bind(serverSocket,
             (struct sockaddr *)&serverAddr,
             sizeof(serverAddr)) < 0)
    {
        perror("Bind failed");
        close(serverSocket);
        return 1;
    }

    /* Listen */
    if (listen(serverSocket, 5) < 0)
    {
        perror("Listen failed");
        close(serverSocket);
        return 1;
    }

    printf("ARP Server started on port %d\n", port);

    while (1)
    {
        printf("\nWaiting for client...\n");

        addrSize = sizeof(clientAddr);

        /* Accept one client */
        clientSocket = accept(serverSocket,
                              (struct sockaddr *)&clientAddr,
                              &addrSize);

        if (clientSocket < 0)
        {
            perror("Accept failed");
            continue;
        }

        printf("Client connected.\n");

        /* Receive IP address */
        memset(ip, 0, SIZE);

        recv(clientSocket, ip, SIZE - 1, 0);

        printf("Received IP address: %s\n", ip);

        found = 0;

        /* Search ARP cache */
        for (i = 0; i < entryCount; i++)
        {
            if (strcmp(arpTable[i].ip, ip) == 0)
            {
                found = 1;

                strcpy(response, arpTable[i].mac);

                /* Send MAC address */
                send(clientSocket,
                     response,
                     strlen(response) + 1,
                     0);

                printf("IP found in ARP cache.\n");
                printf("MAC address: %s\n",
                       arpTable[i].mac);

                break;
            }
        }

        /* IP not found */
        if (found == 0)
        {
            strcpy(response, "NOT_FOUND");

            send(clientSocket,
                 response,
                 strlen(response) + 1,
                 0);

            printf("IP not found in ARP cache.\n");

            /* Receive MAC address from client */
            memset(mac, 0, SIZE);

            recv(clientSocket, mac, SIZE - 1, 0);

            printf("Received MAC address: %s\n", mac);

            /* Insert into ARP table */
            if (entryCount < MAX_ENTRIES)
            {
                strcpy(arpTable[entryCount].ip, ip);
                strcpy(arpTable[entryCount].mac, mac);

                entryCount++;

                strcpy(response, "INSERTED");

                send(clientSocket,
                     response,
                     strlen(response) + 1,
                     0);

                printf("New ARP entry inserted.\n");
            }
            else
            {
                strcpy(response, "TABLE_FULL");

                send(clientSocket,
                     response,
                     strlen(response) + 1,
                     0);

                printf("ARP table is full.\n");
            }
        }

        /* Display ARP table */
        printf("\n----- ARP CACHE TABLE -----\n");
        printf("%-20s %-20s\n", "IP Address", "MAC Address");

        for (i = 0; i < entryCount; i++)
        {
            printf("%-20s %-20s\n",
                   arpTable[i].ip,
                   arpTable[i].mac);
        }

        printf("---------------------------\n");

        close(clientSocket);

        printf("Client disconnected.\n");
    }

    close(serverSocket);

    return 0;
}
