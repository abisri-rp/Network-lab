#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>

#define DEFAULT_PORT 8096
#define DEFAULT_IP "127.0.0.1"
#define SIZE 1024

int main(int argc, char *argv[])
{
    int sockfd;
    char message[SIZE];
    char buffer[SIZE];

    int port = DEFAULT_PORT;
    char *ip_addr = DEFAULT_IP;

    if (argc > 1)
    {
        ip_addr = argv[1];
    }

    if (argc > 2)
    {
        port = atoi(argv[2]);
    }
    else if (argc == 1)
    {
        printf("Usage: %s [IP_Address] [Port]\n", argv[0]);
        printf("Using defaults: IP=%s, Port=%d\n\n",
               ip_addr, port);
    }

    struct sockaddr_in server_addr;
    socklen_t server_len = sizeof(server_addr);

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        printf("Socket creation failed\n");
        return 1;
    }

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);
    server_addr.sin_addr.s_addr = inet_addr(ip_addr);

    printf("Enter message to echo: ");

    fgets(message, SIZE, stdin);

    message[strcspn(message, "\n")] = '\0';
    sendto(sockfd,
           message,
           strlen(message),
           0,
           (struct sockaddr *)&server_addr,
           server_len);

    int n = recvfrom(sockfd,
                     buffer,
                     SIZE - 1,
                     0,
                     (struct sockaddr *)&server_addr,
                     &server_len);

    if (n < 0)
    {
        perror("Receive failed");
        close(sockfd);
        return 1;
    }

    buffer[n] = '\0';
    printf("Echo received from server: %s\n", buffer);

    close(sockfd);

    return 0;
}
