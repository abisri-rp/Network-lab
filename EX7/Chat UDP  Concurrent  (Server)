// udp_server.c

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <pthread.h>

#define PORT 8020
#define MAX 1024

typedef struct {
    int sockfd;
    struct sockaddr_in client;
} Client;

Client clients[10];
int client_count = 0;

pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;

void *handle_client(void *arg)
{
    int index = *(int *)arg;
    char buffer[MAX];

    while (1)
    {
        memset(buffer, 0, MAX);

        int n = recvfrom(clients[index].sockfd,
                         buffer,
                         MAX - 1,
                         0,
                         NULL,
                         NULL);

        if (n <= 0)
            break;

        buffer[n] = '\0';

        printf("Client %d: %s\n", index + 1, buffer);

        if (strcmp(buffer, "exit") == 0)
            break;

        sendto(clients[index].sockfd,
               buffer,
               strlen(buffer),
               0,
               (struct sockaddr *)&clients[index].client,
               sizeof(clients[index].client));
    }

    free(arg);
    return NULL;
}

int main()
{
    int sockfd;
    struct sockaddr_in server, client;
    socklen_t client_len;
    char buffer[MAX];

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr *)&server, sizeof(server)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }

    printf("UDP Concurrent Chat Server Started...\n");
    printf("Waiting for clients...\n");

    while (client_count < 10)
    {
        client_len = sizeof(client);

        memset(buffer, 0, MAX);

        recvfrom(sockfd,
                 buffer,
                 MAX - 1,
                 0,
                 (struct sockaddr *)&client,
                 &client_len);

        buffer[MAX - 1] = '\0';

        if (strcmp(buffer, "JOIN") == 0)
        {
            pthread_mutex_lock(&lock);

            clients[client_count].sockfd = sockfd;
            clients[client_count].client = client;

            printf("Client %d connected.\n", client_count + 1);

            int *index = malloc(sizeof(int));
            *index = client_count;

            pthread_t thread;
            pthread_create(&thread, NULL, handle_client, index);
            pthread_detach(thread);

            client_count++;

            pthread_mutex_unlock(&lock);
        }
    }

    close(sockfd);

    return 0;
}
