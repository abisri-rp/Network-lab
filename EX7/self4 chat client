#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <arpa/inet.h>
#include "chat_protocol.h"

int sock_fd = 0;

// Async background thread to catch and display messages broadcasted by the server
void *receive_messages_handler(void *arg) {
    char message[BUFFER_SIZE];
    int read_bytes;

    while ((read_bytes = recv(sock_fd, message, sizeof(message) - 1, 0)) > 0) {
        message[read_bytes] = '\0';
        // Force immediate console rendering flush sequences
        printf("%s", message);
        fflush(stdout);
    }

    if (read_bytes == 0) {
        printf("\n[INFO] Connection closed by the remote chat server host.\n");
    } else {
        printf("\n[ERROR] An error occurred in the network communication stream.\n");
    }
    
    exit(EXIT_SUCCESS);
}

int main() {
    struct sockaddr_in serv_addr;
    char buffer[BUFFER_SIZE];
    char username[64];

    if ((sock_fd = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
        printf("\n Error: Socket layer failed to initialize. \n");
        return -1;
    }

    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(SERVER_PORT);

    if (inet_pton(AF_INET, SERVER_IP, &serv_addr.sin_addr) <= 0) {
        printf("\n Error: Invalid destination server routing target address. \n");
        return -1;
    }

    if (connect(sock_fd, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        printf("\n Connection Error: Chat server is currently offline or unreachable. \n");
        return -1;
    }

    printf("=== Welcome to the Terminal Chat Room System ===\n");
    printf("Choose your chat nickname: ");
    if (fgets(username, sizeof(username), stdin) == NULL) return -1;
    username[strcspn(username, "\n")] = '\0';

    // Send identity configuration footprint parameter down immediately upon linking
    send(sock_fd, username, strlen(username), 0);
    printf("[SYSTEM] Securely connected. Type messages freely! Type 'exit' to log out.\n\n");

    // Spawn background reader thread to receive incoming text asynchronously
    pthread_t recv_thread;
    if (pthread_create(&recv_thread, NULL, receive_messages_handler, NULL) != 0) {
        printf("[ERROR] Failed to instantiate asynchronous notification listener threads.\n");
        close(sock_fd);
        return -1;
    }
    pthread_detach(recv_thread);

    // Main thread execution pipeline handles user input capture processing 
    while (1) {
        if (fgets(buffer, sizeof(buffer), stdin) == NULL) break;
        buffer[strcspn(buffer, "\n")] = '\0';

        if (strcmp(buffer, "exit") == 0) {
            send(sock_fd, buffer, strlen(buffer), 0);
            break;
        }

        if (strlen(buffer) == 0) continue;

        // Transmit string stream data package
        if (send(sock_fd, buffer, strlen(buffer), 0) < 0) {
            printf("[ERROR] Message failed to transmit to the server.\n");
            break;
        }
    }

    close(sock_fd);
    printf("[CLIENT] Chat session ended gracefully. Goodbye!\n");
    return 0;
}
