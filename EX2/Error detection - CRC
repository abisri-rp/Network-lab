#define MAX_STR 256

static char frameStreams[MAX_FRAMES][MAX_BITS];
static int payloadStartIdx[MAX_FRAMES];
static int payloadLenArr[MAX_FRAMES];
static int crcStartIdx[MAX_FRAMES];
static int crcLenArr[MAX_FRAMES];
static char linebuf[MAX_BITS];
static char workData[MAX_BITS];
static void trim(char *s) {
    int i = 0, j = (int)strlen(s) - 1;
    while (i <= j && isspace((unsigned char)s[i])) i++;
    while (j >= i && isspace((unsigned char)s[j])) j--;
    if (i == 0 && j == (int)strlen(s) - 1) return;
    int dst = 0;
    int k;
    for (k = i; k <= j; k++) s[dst++] = s[k];
    s[dst] = '\0';
}
static void remove_spaces_inplace(char *s) {
    int r = 0, w = 0;
    while (s[r]) {
        if (s[r] != ' ' && s[r] != '\t') s[w++] = s[r];
        r++;
    }
    s[w] = '\0';
}
void computeCRC(const char *inputBits, const char *generator, char *remainder) {
    int genLen = (int)strlen(generator);
    int inputLen = (int)strlen(inputBits);
    if (genLen < 2 || inputLen < genLen - 1) {
        remainder[0] = '\0';
        return;
    }
    if (inputLen >= MAX_BITS - 1) {
        remainder[0] = '\0';
        return;
    }
    strcpy(workData, inputBits);
    int i, j;
    for (i = 0; i <= inputLen - genLen; i++) {
        if (workData[i] == '1') {
            for (j = 0; j < genLen; j++) {
                workData[i + j] = (workData[i + j] == generator[j]) ? '0' : '1';
            }
        }
    }
    if (genLen - 1 > 0) {
        strncpy(remainder, workData + (inputLen - genLen + 1), genLen - 1);
        remainder[genLen - 1] = '\0';
    } else {
        remainder[0] = '\0';
    }
}
static int extract_generator_from_line(const char *ln, char *outGen, int outSize) {
    const char *p = strstr(ln, "Generator");
    if (!p) p = strstr(ln, "generator");
    if (!p) return 0;
    p = strchr(ln, '=');
    if (!p) return 0;
    p++;
    while (*p && isspace((unsigned char)*p)) p++;
    int idx = 0;
    while (*p && (*p == '0' || *p == '1') && idx < outSize - 1) {
        outGen[idx++] = *p++;
    }
    outGen[idx] = '\0';
    return (idx > 0);
}
static int parse_frame_stream_line(const char *ln, char *outFullStream, int fullSize,
                                   int *outPayloadStart, int *outPayloadLen,
                                   int *outCrcStart, int *outCrcLen) {
    char tmp[MAX_BITS];
    char *tokens[256];
    int tcount = 0;
    char *tok;
    strncpy(tmp, ln, sizeof(tmp) - 1);
    tmp[sizeof(tmp) - 1] = '\0';
    tok = strtok(tmp, " \t\r\n");
    while (tok != NULL && tcount < (int)(sizeof(tokens)/sizeof(tokens[0]))) {
        tokens[tcount++] = tok;
        tok = strtok(NULL, " \t\r\n");
    }
    if (tcount >= 5) {
        int startIdx = 3; /* token index where bit tokens start */
        int i;
        outFullStream[0] = '\0';
        for (i = startIdx; i < tcount; i++) {
            char tokenCopy[MAX_STR];
            strncpy(tokenCopy, tokens[i], sizeof(tokenCopy) - 1);
            tokenCopy[sizeof(tokenCopy) - 1] = '\0';
            remove_spaces_inplace(tokenCopy);
            strncat(outFullStream, tokenCopy, fullSize - strlen(outFullStream) - 1);
        }
        char payloadCopy[MAX_BITS], crcCopy[MAX_STR];
        strncpy(payloadCopy, tokens[tcount - 2], sizeof(payloadCopy) - 1);
        payloadCopy[sizeof(payloadCopy) - 1] = '\0';
        strncpy(crcCopy, tokens[tcount - 1], sizeof(crcCopy) - 1);
        crcCopy[sizeof(crcCopy) - 1] = '\0';
        remove_spaces_inplace(payloadCopy);
        remove_spaces_inplace(crcCopy);
        int pos = 0;
        for (i = startIdx; i < tcount - 2; i++) {
            char tokenCopy[MAX_STR];
            strncpy(tokenCopy, tokens[i], sizeof(tokenCopy)-1);
            tokenCopy[sizeof(tokenCopy)-1] = '\0';
            remove_spaces_inplace(tokenCopy);
            pos += (int)strlen(tokenCopy);
        }
        *outPayloadStart = pos;
        *outPayloadLen = (int)strlen(payloadCopy);
        *outCrcStart = pos + *outPayloadLen;
        *outCrcLen = (int)strlen(crcCopy);
        return 1;
    }
    return 0;
}
int main(void) {
    FILE *inFile = fopen("output.txt", "r");
    if (!inFile) {
        printf("Could not open file\n");
        return 1;
    }
    char generator[MAX_STR] = "";
    int expectedFrames = 0;
    while (fgets(linebuf, sizeof(linebuf), inFile)) {
        if (generator[0] == '\0') {
            extract_generator_from_line(linebuf, generator, sizeof(generator));
        }
        if (expectedFrames == 0) {
            const char *pNum = strstr(linebuf, "frames =");
            if (!pNum) pNum = strstr(linebuf, "Frames =");
            if (!pNum) pNum = strstr(linebuf, "frames=");
            if (!pNum) pNum = strstr(linebuf, "Frames=");
            if (pNum) {
                const char *eq = strchr(pNum, '=');
                if (eq) {
                    eq++;
                    while (*eq && isspace((unsigned char)*eq)) eq++;
                    int val = 0;
                    while (*eq >= '0' && *eq <= '9') {
                        val = val * 10 + (*eq - '0');
                        eq++;
                    }
                    expectedFrames = val;
                }
            }
        }
    }
    if (generator[0] == '\0') {
        printf("Generator not found in output.txt.\n");
        printf("Enter generator binary string: ");
        if (fgets(generator, sizeof(generator), stdin) == NULL) {
            fclose(inFile);
            return 1;
        }
        char *pnl = strchr(generator, '\n');
        if (pnl) *pnl = '\0';
        remove_spaces_inplace(generator);
    }
    rewind(inFile);
    int totalFramesRead = 0;
    while (fgets(linebuf, sizeof(linebuf), inFile) && totalFramesRead<MAX_FRAMES)
    {
       char *p;
        p = strstr(linebuf, "||");
        if (p) {
            p += 2;
            while (*p && isspace((unsigned char)*p)) p++;
            trim(p);
            remove_spaces_inplace(p);
            if (strlen(p) > 0) {
                strncpy(frameStreams[totalFramesRead], p, MAX_BITS - 1);
                frameStreams[totalFramesRead][MAX_BITS - 1] = '\0';
                int genDegree = (int)strlen(generator) - 1;
                int fullLen = (int)strlen(frameStreams[totalFramesRead]);
                if (genDegree > 0 && fullLen > genDegree) {
                    payloadStartIdx[totalFramesRead] = 0;
                    payloadLenArr[totalFramesRead] = fullLen - genDegree;
                    crcStartIdx[totalFramesRead] = fullLen - genDegree;
                    crcLenArr[totalFramesRead] = genDegree;
                } else {
                    payloadStartIdx[totalFramesRead] = 0;
                    payloadLenArr[totalFramesRead] = fullLen;
                    crcStartIdx[totalFramesRead] = fullLen;
                    crcLenArr[totalFramesRead] = 0;
                }
                totalFramesRead++;
            }
            continue;
        }
        if (strstr(linebuf, "Frame") && strstr(linebuf, "Stream")) {
            char fullStream[MAX_BITS];
            int pstart, plen, cstart, clen;
            if (parse_frame_stream_line(linebuf, fullStream, sizeof(fullStream), &pstart, &plen, &cstart, &clen)) {
                strncpy(frameStreams[totalFramesRead], fullStream, MAX_BITS - 1);
                frameStreams[totalFramesRead][MAX_BITS - 1] = '\0';
                payloadStartIdx[totalFramesRead] = pstart;
                payloadLenArr[totalFramesRead] = plen;
                crcStartIdx[totalFramesRead] = cstart;
                crcLenArr[totalFramesRead] = clen;
                totalFramesRead++;
            }
            continue;
        }
        {
            int cnt01 = 0, cntOther = 0, k;
            for (k = 0; linebuf[k] && linebuf[k] != '\n' && k < (int)sizeof(linebuf); k++) {
                if (linebuf[k] == '0' || linebuf[k] == '1' || isspace((unsigned char)linebuf[k])) cnt01++;
                else cntOther++;
            }
            if (cnt01 > 10 && cntOther == 0) {
                char tmp[MAX_BITS];
                strncpy(tmp, linebuf, sizeof(tmp)-1);
                tmp[sizeof(tmp)-1] = '\0';
                trim(tmp);
                remove_spaces_inplace(tmp);
                if (strlen(tmp) > 0) {
                    strncpy(frameStreams[totalFramesRead], tmp, MAX_BITS - 1);
                    frameStreams[totalFramesRead][MAX_BITS - 1] = '\0';
                    int genDegree = (int)strlen(generator) - 1;
                    int fullLen = (int)strlen(frameStreams[totalFramesRead]);
                    if (genDegree > 0 && fullLen > genDegree) {
                        payloadStartIdx[totalFramesRead] = 0;
                        payloadLenArr[totalFramesRead] = fullLen - genDegree;
                        crcStartIdx[totalFramesRead] = fullLen - genDegree;
                        crcLenArr[totalFramesRead] = genDegree;
                    } else {
                        payloadStartIdx[totalFramesRead] = 0;
                        payloadLenArr[totalFramesRead] = fullLen;
                        crcStartIdx[totalFramesRead] = fullLen;
                        crcLenArr[totalFramesRead] = 0;
                    }
                    totalFramesRead++;
                }
            }
        }
    }
    fclose(inFile);
    if (totalFramesRead == 0) {
        printf("No frames found in file.\n");
        return 1;
    }
    printf("Found %d frames. Generator = %s (degree = %d)\n", totalFramesRead, generator, (int)strlen(generator) - 1);
    printf("Do you want to simulate a transmission error? (y/n): ");
    char simChoice = 'n';
    if (scanf(" %c", &simChoice) != 1) simChoice = 'n';
    if (simChoice == 'y' || simChoice == 'Y') {
        int targetFrame = 0;
        int bitPos = 0;
        while (1) {
            printf("Enter frame number to modify (Range: 1 to %d): ", totalFramesRead);
            if (scanf("%d", &targetFrame) != 1) {
                int ch;
                while ((ch = getchar()) != '\n' && ch != EOF) {}
                continue;
            }
            if (targetFrame >= 1 && targetFrame <= totalFramesRead) break;
            printf(" Invalid frame! Please choose a number between 1 and %d.\n", totalFramesRead);
        }
        {
            int frameIdx = targetFrame - 1;
            int frameLen = (int)strlen(frameStreams[frameIdx]);
            int pstart = payloadStartIdx[frameIdx];
            int plen = payloadLenArr[frameIdx];
            int cstart = crcStartIdx[frameIdx];
            int clen = crcLenArr[frameIdx];
            int dataStartBit = pstart + 1; /* 1-based */
            int dataEndBit = (cstart > pstart ? cstart : (pstart + plen)) ; /* exclusive of CRC start */
            if (dataEndBit == 0) dataEndBit = frameLen;
            printf("\nFrame #%d Layout Breakdown:\n", targetFrame);
            printf("Total Bits  : %d\n", frameLen);
            printf("Data Range  : Bits %d to %d\n", dataStartBit, dataEndBit);
            printf("CRC Range   : Bits %d to %d\n", cstart + 1, (cstart + clen));
            while (1) {
                printf("Enter bit position to flip (Range: %d to %d): ", dataStartBit, dataEndBit);
                if (scanf("%d", &bitPos) != 1) {
                    int ch;
                    while ((ch = getchar()) != '\n' && ch != EOF) {}
                    continue;
                }
                if (bitPos >= dataStartBit && bitPos <= dataEndBit) break;
                printf(" Invalid bit position! Choose a position between %d and %d.\n", dataStartBit, dataEndBit);
            }
            int bitIdx = bitPos - 1;
            if (bitIdx >= 0 && bitIdx < frameLen) {
                if (frameStreams[frameIdx][bitIdx] == '0') frameStreams[frameIdx][bitIdx] = '1';
                else if (frameStreams[frameIdx][bitIdx] == '1') frameStreams[frameIdx][bitIdx] = '0';
                else {
                    printf("Selected position is not a 0/1 bit; no flip performed.\n");
                }
                printf("\n *** Transmission Error Simulated** *\n");
                printf("Frame %d : Bit %d flipped.\n", targetFrame, bitPos);
            } else {
                printf("Bit index out of range for this frame.\n");
            }
        }
    }
    printf("\nVerifying frames:\n");
    {
        int i, d;
        int genDegree = (int)strlen(generator) - 1;
        char remainder[MAX_STR];
        for (i = 0; i < totalFramesRead; i++) {
            int pstart = payloadStartIdx[i];
            int plen = payloadLenArr[i];
            int cstart = crcStartIdx[i];
            int clen = crcLenArr[i];
            char combined[MAX_BITS];
            if (plen > 0 && clen > 0 && pstart >= 0 && cstart >= pstart) {
                /* extract payload and crc from the stored full stream */
                if (pstart + plen + clen >= MAX_BITS) {
                    printf("Frame %02d : Error - sizes exceed buffer\n", i + 1);
                    continue;
                }
                combined[0] = '\0';
                strncat(combined, frameStreams[i] + pstart, plen);
                strncat(combined, frameStreams[i] + cstart, clen);
            } else {
                /* fallback: treat whole stored stream as combined payload+crc */
                strncpy(combined, frameStreams[i], sizeof(combined) - 1);
                combined[sizeof(combined) - 1] = '\0';
            }
            computeCRC(combined, generator, remainder);
            int errorDetected = 0;
            for (d = 0; d < genDegree; d++) {
                if (remainder[d] != '0') { errorDetected = 1; break; }
            }
            printf("Frame %02d : %s  (remainder = %s)\n", i + 1, errorDetected ? "FAIL" : "PASS", remainder);
        }
    }

    return 0;
}

