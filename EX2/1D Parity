1D Parity Sender

#include <stdio.h>
#include <string.h>
#define MAX_MESSAGE 100
char binaryBlock[9];
void convertToBinary(char character)
{
    int bit;
    int index = 0;
    for (bit = 6; bit >= 0; bit--)
    {
        binaryBlock[index++] = ((character >> bit) & 1) + '0';
    }
    binaryBlock[7] = '\0';
}
void generateOddParity()
{
    int i;
    int oneCount = 0;
    for (i = 0; i < 7; i++)
    {
        if (binaryBlock[i] == '1')
        {
            oneCount++;
        }
    }
    if (oneCount % 2 == 0)
        binaryBlock[7] = '1';
    else
        binaryBlock[7] = '0';
    binaryBlock[8] = '\0';
}
void sender()
{
    char message[MAX_MESSAGE];
    FILE *outputFile;
    int messageLength;
    int i;
    printf("Enter Message: ");
    scanf("%s", message);
    outputFile = fopen("out.txt", "w");
    if (outputFile == NULL)
    {
        printf("Error creating channel.txt\n");
        return;
    }
    messageLength = strlen(message);
    fprintf(outputFile, "%d\n", messageLength);
    for (i = 0; i < messageLength; i++)
    {
        convertToBinary(message[i]);
        generateOddParity();
        printf("Character %c : %s\n", message[i], binaryBlock);
        fprintf(outputFile, "%s\n", binaryBlock);
    }
    fclose(outputFile);
}
int main()
{
    sender();
    return 0;
}


1D parity Receiver

#include <stdio.h>
#include <string.h>
#define MAX_SIZE 100
char receivedData[9];
void receiver()
{
    FILE *receiverFile;
    int totalCharacters;
    int character;
    char choice;
    int flipCount;
    int i;
    int position;
    int oneCount;
    int bit;
    receiverFile = fopen("out.txt", "r");
    if (receiverFile == NULL)
    {
        printf("Error: channel.txt not found.\n");
        printf("Run the sender program first.\n");
        return;
    }
    fscanf(receiverFile, "%d", &totalCharacters);
    for (character = 0; character < totalCharacters; character++)
    {
        fscanf(receiverFile, "%8s", receivedData);
        printf("\nReceived Block %d : %s\n",
               character + 1, receivedData);
        printf("Do you want to simulate transmission error? (y/n): ");
        scanf(" %c", &choice);
        if (choice == 'y' || choice == 'Y')
        {
            printf("Enter number of bits to flip: ");
            scanf("%d", &flipCount);
            for (i = 1; i <= flipCount; i++)
            {
                while (1)
                {
                    printf("Enter bit position %d (1-8): ", i);
                    scanf("%d", &position);
                    if (position >= 1 && position <= 8)
                        break;
                    printf("Invalid position! Enter between 1 and 8.\n");
                }
                if(receivedData[position - 1] == '0')
                    receivedData[position - 1] = '1';
                else
                    receivedData[position - 1] = '0';
            }
            printf("\nModified Block : %s\n", receivedData);
        }
        oneCount = 0;
        for (bit = 0; bit < 8; bit++)
        {
            if (receivedData[bit] == '1')
            {
                oneCount++;
            }
        }
        printf("Number of 1's : %d\n", oneCount);
        if (oneCount % 2 != 0)
        {
            printf("Result : ACCEPTED\n");
            printf("Status : No Error Detected\n");
        }
        else
        {
            printf("Result : REJECTED\n");
            printf("Status : Error Detected\n");
        }
    }
    fclose(receiverFile);
}
int main()
{
   receiver();
   return 0;
}
